{
  "operations": [
    {
      "id": "createRun",
      "method": "POST",
      "path": "/api/v1/agent-runs",
      "requestSchema": "CreateRunRequest",
      "headers": [
        {
          "name": "Idempotency-Key",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": [
        {
          "status": 200,
          "contentType": "text/event-stream"
        },
        {
          "status": 200,
          "contentType": "application/json",
          "schema": "OperationReceipt"
        }
      ]
    },
    {
      "id": "getOperation",
      "method": "GET",
      "path": "/api/v1/agent-runs/operations/{operationId}",
      "responses": [
        {
          "status": 200,
          "contentType": "application/json",
          "schema": "OperationReceipt"
        }
      ]
    },
    {
      "id": "cancelRun",
      "method": "POST",
      "path": "/api/v1/agent-runs/{runId}/cancel",
      "responses": [
        {
          "status": 200,
          "contentType": "application/json",
          "schema": "OperationReceipt"
        },
        {
          "status": 202,
          "contentType": "application/json",
          "schema": "CancellationRequested"
        }
      ]
    }
  ],
  "schemas": {
    "CreateRunRequest": {
      "additionalProperties": false,
      "properties": {
        "prompt": {
          "maxLength": 131072,
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "sourceObjectRefs": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Sourceobjectrefs",
          "type": "array"
        }
      },
      "required": [
        "prompt"
      ],
      "title": "CreateRunRequest",
      "type": "object"
    },
    "CancellationRequested": {
      "properties": {
        "runId": {
          "title": "Runid",
          "type": "string"
        },
        "cancelStatus": {
          "const": "requested",
          "title": "Cancelstatus",
          "type": "string"
        }
      },
      "required": [
        "runId",
        "cancelStatus"
      ],
      "title": "CancellationRequested",
      "type": "object"
    },
    "OperationReceipt": {
      "properties": {
        "operationId": {
          "title": "Operationid",
          "type": "string"
        },
        "runId": {
          "title": "Runid",
          "type": "string"
        },
        "acceptedAt": {
          "format": "date-time",
          "title": "Acceptedat",
          "type": "string"
        },
        "deadlineAt": {
          "format": "date-time",
          "title": "Deadlineat",
          "type": "string"
        },
        "expiresAt": {
          "format": "date-time",
          "title": "Expiresat",
          "type": "string"
        },
        "runStatus": {
          "enum": [
            "queued",
            "running",
            "completed",
            "failed",
            "cancelled"
          ],
          "title": "Runstatus",
          "type": "string"
        },
        "cleanupStatus": {
          "enum": [
            "pending",
            "cleaning",
            "completed",
            "failed"
          ],
          "title": "Cleanupstatus",
          "type": "string"
        },
        "reasonCode": {
          "title": "Reasoncode",
          "type": "string"
        }
      },
      "required": [
        "operationId",
        "runId",
        "acceptedAt",
        "deadlineAt",
        "expiresAt",
        "runStatus",
        "cleanupStatus"
      ],
      "title": "OperationReceipt",
      "type": "object"
    },
    "RunProgress": {
      "properties": {
        "runId": {
          "title": "Runid",
          "type": "string"
        },
        "stage": {
          "enum": [
            "queued",
            "running",
            "delivering"
          ],
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "runId",
        "stage"
      ],
      "title": "RunProgress",
      "type": "object"
    },
    "OutputText": {
      "properties": {
        "runId": {
          "title": "Runid",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "runId",
        "text"
      ],
      "title": "OutputText",
      "type": "object"
    },
    "ArtifactStarted": {
      "properties": {
        "artifactId": {
          "title": "Artifactid",
          "type": "string"
        },
        "filename": {
          "title": "Filename",
          "type": "string"
        },
        "contentType": {
          "title": "Contenttype",
          "type": "string"
        },
        "sizeBytes": {
          "minimum": 0,
          "title": "Sizebytes",
          "type": "integer"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifactId",
        "filename",
        "contentType",
        "sizeBytes",
        "sha256"
      ],
      "title": "ArtifactStarted",
      "type": "object"
    },
    "ArtifactChunk": {
      "properties": {
        "artifactId": {
          "title": "Artifactid",
          "type": "string"
        },
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "data": {
          "contentEncoding": "base64",
          "title": "Data",
          "type": "string"
        }
      },
      "required": [
        "artifactId",
        "index",
        "data"
      ],
      "title": "ArtifactChunk",
      "type": "object"
    },
    "ArtifactCompleted": {
      "properties": {
        "artifactId": {
          "title": "Artifactid",
          "type": "string"
        },
        "filename": {
          "title": "Filename",
          "type": "string"
        },
        "contentType": {
          "title": "Contenttype",
          "type": "string"
        },
        "sizeBytes": {
          "minimum": 0,
          "title": "Sizebytes",
          "type": "integer"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "chunkCount": {
          "minimum": 0,
          "title": "Chunkcount",
          "type": "integer"
        }
      },
      "required": [
        "artifactId",
        "filename",
        "contentType",
        "sizeBytes",
        "sha256",
        "chunkCount"
      ],
      "title": "ArtifactCompleted",
      "type": "object"
    },
    "ArtifactFailed": {
      "properties": {
        "artifactId": {
          "title": "Artifactid",
          "type": "string"
        },
        "error": {
          "const": "artifact_delivery_failed",
          "title": "Error",
          "type": "string"
        }
      },
      "required": [
        "artifactId",
        "error"
      ],
      "title": "ArtifactFailed",
      "type": "object"
    },
    "RunFinished": {
      "properties": {
        "runId": {
          "title": "Runid",
          "type": "string"
        },
        "runStatus": {
          "enum": [
            "completed",
            "failed",
            "cancelled"
          ],
          "title": "Runstatus",
          "type": "string"
        },
        "deliveryStatus": {
          "enum": [
            "completed",
            "failed"
          ],
          "title": "Deliverystatus",
          "type": "string"
        },
        "reasonCode": {
          "title": "Reasoncode",
          "type": "string"
        }
      },
      "required": [
        "runId",
        "runStatus",
        "deliveryStatus"
      ],
      "title": "RunFinished",
      "type": "object"
    }
  },
  "events": [
    {
      "name": "runAccepted",
      "schema": "OperationReceipt"
    },
    {
      "name": "runProgress",
      "schema": "RunProgress"
    },
    {
      "name": "outputText",
      "schema": "OutputText"
    },
    {
      "name": "artifactStarted",
      "schema": "ArtifactStarted"
    },
    {
      "name": "artifactChunk",
      "schema": "ArtifactChunk"
    },
    {
      "name": "artifactCompleted",
      "schema": "ArtifactCompleted"
    },
    {
      "name": "artifactFailed",
      "schema": "ArtifactFailed"
    },
    {
      "name": "runFinished",
      "schema": "RunFinished"
    }
  ]
}
