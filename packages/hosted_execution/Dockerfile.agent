FROM rust:1.95.0-bookworm@sha256:6258907abe69656e41cd992e0b705cdcfabcbbe3db374f92ed2d47121282d4a1 AS build

WORKDIR /src
COPY . .
RUN cargo build --release --locked -p hosted_execution --bin execution_agent

FROM ghcr.io/astral-sh/uv:0.11.6@sha256:b1e699368d24c57cda93c338a57a8c5a119009ba809305cc8e86986d4a006754 AS uv
FROM node:22.21.0-bookworm-slim@sha256:f9f7f95dcf1f007b007c4dcd44ea8f7773f931b71dc79d57c216e731c87a090b AS node

FROM python:3.12.10-slim-bookworm@sha256:fd95fa221297a88e1cf49c55ec1828edd7c5a428187e67b5d1805692d11588db AS python-deps

ENV UV_PROJECT_ENVIRONMENT=/opt/centaeris/venv

COPY --from=uv /uv /uvx /bin/
WORKDIR /src
COPY pyproject.toml uv.lock .python-version ./
COPY packages/api/pyproject.toml packages/api/pyproject.toml
COPY packages/hosted_execution/pyproject.toml packages/hosted_execution/pyproject.toml
COPY packages/worker/pyproject.toml packages/worker/pyproject.toml
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --package centaeris-sandbox-tools --no-install-workspace

FROM python:3.12.10-slim-bookworm@sha256:fd95fa221297a88e1cf49c55ec1828edd7c5a428187e67b5d1805692d11588db

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PATH=/opt/centaeris/bin:/opt/centaeris/venv/bin:/usr/local/bin:/usr/bin:/bin

RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=5 update \
    && DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
        bash ca-certificates curl file fontconfig fonts-noto-cjk fonts-noto-core git jq \
        libharfbuzz-subset0 libharfbuzz0b libpango-1.0-0 libpangoft2-1.0-0 \
        libreoffice-calc libreoffice-impress libreoffice-writer \
        passwd poppler-utils ripgrep unzip xz-utils zip \
    && rm -rf /var/lib/apt/lists/*

RUN /usr/sbin/groupadd --gid 10001 agent \
    && /usr/sbin/useradd --uid 10001 --gid 10001 --home-dir /home/agent --create-home agent \
    && mkdir -p /opt/centaeris/bin /opt/centaeris/plugins /opt/centaeris/system-skills

COPY --from=python-deps /opt/centaeris/venv /opt/centaeris/venv
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=build /src/target/release/execution_agent /opt/centaeris/bin/execution_agent
COPY LICENSE /usr/share/licenses/centaeris-workspace/LICENSE
COPY skills/system /opt/centaeris/system-skills

RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && test "$(node --version)" = "v22.21.0" \
    && python -c "import docx, openpyxl, PIL, pptx, weasyprint" \
    && weasyprint --version

CMD ["/bin/sh", "-c", "/opt/centaeris/bin/execution_agent workspace-watch || { echo 'workspace watcher unavailable; generation is Unknown' >&2; exec sleep infinity; }"]
