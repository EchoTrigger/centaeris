{
  "name": "@centaeris/electron-host",
  "productName": "Centaeris Desktop",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EchoTrigger/centaeris.git",
    "directory": "packages/desktop"
  },
  "type": "module",
  "main": "src/main/index.mjs",
  "scripts": {
    "lint": "pnpm -w run lint:desktop",
    "dev": "node ./scripts/ensure-runtime.mjs --profile debug && electron ./src/main/index.mjs",
    "install:electron": "node ./scripts/ensure-electron.mjs",
    "prebuild": "node ./scripts/ensure-electron.mjs",
    "build": "pnpm run build:renderer && pnpm run build:runtime && node ./scripts/build-dist.mjs",
    "build:runtime": "node ./scripts/ensure-runtime.mjs",
    "check": "pnpm run check:syntax && node --test ./src/main/services/desktopFilePreview.test.mjs ./src/main/services/hostIpc.test.mjs ./src/main/applicationMenu.test.mjs ./src/main/services/defaultWorkspace.test.mjs ./src/main/rendererSecurity.test.mjs ./src/main/services/runtimeHostTransport.test.mjs ./src/main/services/systemSkills.test.mjs ./src/main/tray.test.mjs ./src/main/windowTheme.test.mjs ./src/main/windowLifecycle.test.mjs ./src/main/startup.test.mjs ./scripts/check-javascript-syntax.test.mjs ./scripts/ensure-runtime.test.mjs ./scripts/smoke-runtime-cleanup.test.mjs && pnpm run test:installer && node ./scripts/check-host-parity.mjs",
    "check:syntax": "node ./scripts/check-javascript-syntax.mjs",
    "check:host-parity": "node ./scripts/check-host-parity.mjs",
    "check:dist-licenses": "node ./scripts/check-dist-licenses.mjs --dist \"./dist/Centaeris Desktop\"",
    "test:third-party-licenses": "node --test ./scripts/third-party-licenses.test.mjs ../../scripts/product-licenses.test.mjs",
    "smoke:runtime": "node ./scripts/ensure-runtime.mjs && node ./scripts/smoke-runtime.mjs",
    "presmoke:window": "node ./scripts/ensure-electron.mjs",
    "smoke:window": "pnpm run build:renderer && node ./scripts/build-dist.mjs && node ./scripts/smoke-window.mjs",
    "build:installer": "node ./scripts/build-installer.mjs",
    "test:installer": "node --test ./scripts/installer-preflight.test.mjs ./scripts/installer-input.test.mjs ./scripts/installer-registration.test.mjs ./scripts/distribution-output.test.mjs",
    "smoke:installer": "node ./scripts/smoke-installer.mjs",
    "dev:renderer": "vite",
    "build:renderer": "node ./scripts/build.mjs --mode build",
    "typecheck": "node ./scripts/build.mjs --mode typecheck",
    "test:renderer": "vitest run tests",
    "gate:renderer": "node ./scripts/build.mjs --mode gate && pnpm run lint && pnpm run test:renderer",
    "baseline:transcript": "node ./scripts/run-transcript-baseline.mjs",
    "test:run-error-ui": "node --test tests/browser/run-error-display.acceptance.mjs",
    "lint:source": "pnpm -w run lint:ui-source",
    "lint:hooks": "pnpm -w run lint:hooks",
    "lint:unused": "pnpm -w run lint:unused",
    "preview": "vite preview",
    "preview:visualizations": "vite --host 127.0.0.1 --port 5179 --strictPort",
    "test:transcript-scroll": "node --test tests/browser/transcript-scroll.acceptance.mjs"
  },
  "devDependencies": {
    "electron": "42.10.1",
    "electron-builder": "26.15.3",
    "resedit": "3.0.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.12.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/react-test-renderer": "19.1.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "30.1.3",
    "react-test-renderer": "19.2.7",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "description": "Centaeris local coding agent for Windows",
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@centaeris/ui": "workspace:*",
    "@centaeris/visuals": "workspace:*",
    "@codemirror/commands": "6.10.3",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.11",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/language": "6.12.3",
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.42.0",
    "@dnd-kit/react": "0.5.1",
    "@tailwindcss/postcss": "4.2.4",
    "@tailwindcss/vite": "4.2.4",
    "@tanstack/react-virtual": "3.14.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "i18next": "26.4.2",
    "lucide-react": "1.24.0",
    "motion": "14.4.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-i18next": "17.0.13",
    "react-resizable-panels": "4.14.7",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "4.2.4",
    "tw-animate-css": "1.4.0",
    "zustand": "5.0.14"
  }
}
