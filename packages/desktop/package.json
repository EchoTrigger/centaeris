{
  "name": "@centaeris/electron-host",
  "productName": "Centaeris Desktop",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EchoTrigger/centaeris.git",
    "directory": "packages/desktop"
  },
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "lint": "npm --prefix ../.. run lint:desktop",
    "dev": "node ./scripts/ensure-runtime.mjs --profile debug && electron ./src/main.mjs",
    "install:electron": "node ./scripts/ensure-electron.mjs",
    "prebuild": "node ./scripts/ensure-electron.mjs",
    "build": "npm run build:runtime && node ./scripts/build-dist.mjs",
    "build:runtime": "cargo build --locked --release -p centaeris-runtime",
    "check": "npm run check:syntax && node --test ./src/defaultWorkspace.test.mjs ./src/rendererSecurity.test.mjs ./src/runtimeHostTransport.test.mjs ./src/systemSkills.test.mjs ./src/tray.test.mjs ./scripts/check-javascript-syntax.test.mjs && node ./scripts/check-host-parity.mjs",
    "check:syntax": "node ./scripts/check-javascript-syntax.mjs",
    "check:host-parity": "node ./scripts/check-host-parity.mjs",
    "check:dist-licenses": "node ./scripts/check-dist-licenses.mjs --dist \"./dist/Centaeris Desktop\"",
    "test:third-party-licenses": "node --test ./scripts/third-party-licenses.test.mjs",
    "smoke:runtime": "node ./scripts/ensure-runtime.mjs && node ./scripts/smoke-runtime.mjs",
    "presmoke:window": "node ./scripts/ensure-electron.mjs",
    "smoke:window": "node ./scripts/build-dist.mjs && node ./scripts/smoke-window.mjs"
  },
  "devDependencies": {
    "electron": "42.10.1",
    "resedit": "3.0.2"
  }
}
