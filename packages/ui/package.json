{
  "name": "centaeris-ui",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EchoTrigger/centaeris.git",
    "directory": "packages/ui"
  },
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ./scripts/build.mjs --mode build",
    "baseline:transcript": "node ./scripts/run-transcript-baseline.mjs",
    "test:run-error-ui": "node --test tests/browser/run-error-display.acceptance.mjs",
    "gate": "node ./scripts/build.mjs --mode gate && pnpm run lint && vitest run",
    "lint": "pnpm -w run lint:ui",
    "lint:source": "pnpm -w run lint:ui-source",
    "lint:hooks": "pnpm -w run lint:hooks",
    "lint:unused": "pnpm -w run lint:unused",
    "preview": "vite preview",
    "preview:visualizations": "vite --host 127.0.0.1 --port 5179 --strictPort",
    "test": "vitest run",
    "typecheck": "node ./scripts/build.mjs --mode typecheck"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@centaeris/visualization-react": "workspace:*",
    "@codemirror/commands": "6.10.3",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.11",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/language": "6.12.3",
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.42.0",
    "@dnd-kit/react": "0.5.1",
    "@tailwindcss/postcss": "4.2.4",
    "@tailwindcss/vite": "4.2.4",
    "@tanstack/react-virtual": "3.14.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "i18next": "26.4.2",
    "lucide-react": "1.24.0",
    "motion": "14.4.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-i18next": "17.0.13",
    "react-resizable-panels": "4.14.7",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "4.2.4",
    "tw-animate-css": "1.4.0",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.12.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/react-test-renderer": "19.1.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "30.1.3",
    "react-test-renderer": "19.2.7",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
