# Copy to .env and fill every blank secret.
# Empty required values fail at startup; no fake secret is provided.
DJANGO_SECRET_KEY=
INTERNAL_API_TOKEN=
# Optional internal retained-instance maintenance authority; distinct from worker tokens.
ENVIRONMENT_MAINTENANCE_TOKEN=
AGENT_RUN_AUTHORIZATION_SIGNING_KEY=
CREDENTIAL_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
BOOTSTRAP_SUPERADMIN_PASSWORD=
COMPOSE_PROJECT_NAME=centaeris-workspace
# Source revision is supplied from git HEAD by scripts/workspace/build.py.
POSTGRES_DB=centaeris
POSTGRES_USER=centaeris
RUNTIME_POSTGRES_POOL_SIZE=10
EXECUTION_GLOBAL_LIMIT=8
# Resident sandboxes remain counted while paused or waiting for work.
RESIDENT_GLOBAL_COUNT=16
RESIDENT_GLOBAL_MEMORY_BYTES=34359738368
RESIDENT_GLOBAL_CPU_MILLI=16000
RESIDENT_GLOBAL_PIDS=8192
RESIDENT_GLOBAL_WORKSPACE_BYTES=34359738368
RESIDENT_TENANT_COUNT=4
RESIDENT_TENANT_MEMORY_BYTES=8589934592
RESIDENT_TENANT_CPU_MILLI=4000
RESIDENT_TENANT_PIDS=2048
RESIDENT_TENANT_WORKSPACE_BYTES=17179869184
# Host headroom is optional; leave these unset for Docker host-derived defaults.
# To override, uncomment and set a positive integer. Empty values are invalid.
# RESIDENT_HOST_MEMORY_HEADROOM_BYTES=1073741824
# RESIDENT_HOST_CPU_HEADROOM_MILLI=250
EXECUTION_GLOBAL_QUEUE_LIMIT=128
EXECUTION_TENANT_QUEUE_LIMIT=32
EXECUTION_QUEUE_WAIT_SECONDS=300
RUNTIME_HTTP_REQUEST_LIMIT=24
RUNTIME_HTTP_LISTENER_LIMIT=8
RUNTIME_HTTP_CONTROL_LIMIT=4
# Slow physical cleanup has capacity separate from short control requests.
RUNTIME_HTTP_CLEANUP_LIMIT=2
RUNTIME_HTTP_REQUEST_TIMEOUT_SECONDS=30
RUNTIME_HTTP_CONTROL_TIMEOUT_SECONDS=5
# Required deployment choice: delay between shared work-return audit pages.
WORK_RETURN_AUDIT_INTERVAL_SECONDS=
RUNTIME_POSTGRES_CONTROL_POOL_SIZE=2
RUNTIME_POSTGRES_CLEANUP_POOL_SIZE=2
RUNTIME_POSTGRES_LISTENER_LIMIT=8
RUNTIME_POSTGRES_CHECKOUT_TIMEOUT_MS=5000
RUNTIME_POSTGRES_CONNECT_TIMEOUT_MS=3000
RUNTIME_EXECUTION_RECOVERY_MAX_ATTEMPTS=5
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_DEBUG=1
API_WORKERS=1
# Django ASGI PostgreSQL pool limit per API process; 0 disables it.
API_POSTGRES_POOL_MAX_SIZE=10
STORAGE_STREAM_LANES=4
STORAGE_STREAM_CHUNK_BYTES=65536

# New general single-file policy, based on the existing Artifact attachment ceiling.
UPLOAD_FILE_MAX_BYTES=67108864
# Required deployment choices: public HTTP envelope bytes, dedicated temporary
# volume budget bytes (at least twice the envelope), and concurrent upload slots.
UPLOAD_BODY_MAX_BYTES=
UPLOAD_TEMP_MAX_BYTES=
UPLOAD_MAX_CONCURRENT=
REDIS_BROWSER_MAX_CONNECTIONS=8
RUNTIME_PORT=9000
RUNTIME_START_TIMEOUT_SECONDS=30
RUNTIME_STREAM_TTL_SECONDS=3600
RUNTIME_LIVE_STATE_TTL_SECONDS=3600
API_BASE_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000
# Optional OAuth providers, configured server-side. See docs/workspace/reference/Configuration.md.
SSO_PROVIDERS_JSON=[]
SSO_ALLOW_INSECURE_HTTP=0
WEB_EXTRA_ORIGINS=
WEB_HOST_PORT=3000
API_HOST_PORT=8000
PASSWORD_RESET_ENABLED=0
PASSWORD_RESET_TIMEOUT_SECONDS=86400
PASSWORD_RESET_MAIL_SENDER=0
MODEL_PROVIDER_TIMEOUT_SECONDS=120
# Default resource ceilings per execution environment: 4 GiB memory and 2 CPU cores.
SANDBOX_MEMORY_BYTES=4294967296
SANDBOX_CPU_MILLI=2000
SANDBOX_PIDS_LIMIT=512
SANDBOX_DATA_TMPFS_BYTES=4294967296
# Default sandbox isolation uses gVisor; runc is an explicit host/test override.
OCI_RUNTIME=runsc
# Optional native running-environment scheduling; set both positive values.
# Opt in after native shared-admission acceptance; requires the matching host supervisor.
# CPU caps are shared ceilings; memory is observed at admission. Unknown storage
# keeps its full declared debit: four 4-GiB environments need at least 16 GiB.
# For 20 environments, explicitly raise count/worker/execute/running limits and
# storage budgets (at least 80 GiB while storage measurement is unknown).
RUNTIME_NATIVE_SHARED_ADMISSION=0
RUNTIME_RUNSC_MAX_RUNNING_ENVIRONMENTS=
RUNTIME_RUNSC_IDLE_PAUSE_MS=
KNOWLEDGE_PROCESSOR_DEVICE=cpu
# Physical lifetime: perRun destroys the instance after confirmed Run cleanup.
# retained is an explicit opt-in; drain existing bindings before switching modes.
AGENT_RUN_EXECUTION_MODE=perRun
WORKER_LEASE_MS=120000
# Concurrent jobs per worker process (1-16). Shared by all job kinds.
# Size against host memory and database capacity; replicas multiply this budget.
WORKER_SLOT_COUNT=8
REDIS_MAXMEMORY=512mb
POSTGRES_TEST_HOST_PORT=55432
REDIS_TEST_HOST_PORT=6379
BOOTSTRAP_SUPERADMIN_EMAIL=admin@example.invalid
DEFAULT_FROM_EMAIL=noreply@example.invalid
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT_SECONDS=15

GC_MAX_CLEANUP_ATTEMPTS=5
GC_RETRY_BASE_SECONDS=86400
GC_RETRY_MAX_SECONDS=604800

# The native host supervisor owns task domains. Install its reviewed service/config
# before starting Runtime; workloads never receive this socket or private state.
ENVIRONMENT_HOST_SOCKET_DIRECTORY=/run/centaeris-host
# One sealed static helper is mounted read-only at the same absolute host path.
ENVIRONMENT_EXECUTION_HELPER=/opt/centaeris/host/execution_agent
