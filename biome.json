{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "files": {
    "includes": [
      "packages/sdk/src/**",
      "packages/ui/src/**",
      "packages/visuals/src/**",
      "packages/desktop/src/**",
      "packages/desktop/tests/**",
      "packages/desktop/scripts/**",
      "packages/workspace/web/src/**",
      "packages/workspace/web/tests/**"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "linter": {
      "enabled": false
    }
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": {
        "noUnreachable": "error",
        "noUnusedImports": "warn",
        "noUnusedVariables": "warn",
        "useExhaustiveDependencies": "warn",
        "useHookAtTopLevel": "error"
      },
      "suspicious": {
        "noDebugger": "error",
        "noDuplicateObjectKeys": "error",
        "noDuplicateParameters": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/workspace/web/**"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "preset": "none",
          "correctness": {
            "noUnreachable": "error",
            "noUnusedImports": "error",
            "noUnusedVariables": "error",
            "useExhaustiveDependencies": "error",
            "useHookAtTopLevel": "error"
          },
          "suspicious": {
            "noDebugger": "error",
            "noDuplicateObjectKeys": "error",
            "noDuplicateParameters": "error",
            "noExplicitAny": "error"
          }
        }
      }
    }
  ]
}
