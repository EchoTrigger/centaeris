{
  "name": "centaeris",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EchoTrigger/centaeris.git"
  },
  "scripts": {
    "lint": "npm run lint:ui && npm run lint:desktop",
    "lint:ui": "node ./node_modules/@biomejs/biome/bin/biome lint packages/ui/src packages/ui/tests packages/ui/scripts",
    "lint:desktop": "node ./node_modules/@biomejs/biome/bin/biome lint packages/desktop/src packages/desktop/scripts",
    "lint:hooks": "node ./node_modules/@biomejs/biome/bin/biome lint packages/ui/src packages/ui/tests --only=lint/correctness/useExhaustiveDependencies",
    "lint:unused": "node ./node_modules/@biomejs/biome/bin/biome lint packages/ui/src packages/ui/tests packages/ui/scripts packages/desktop/src packages/desktop/scripts --only=lint/correctness/noUnusedImports --only=lint/correctness/noUnusedVariables",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "workspaces": [
    "packages/ui",
    "packages/desktop"
  ],
  "engines": {
    "node": "22.21.0",
    "npm": "10.9.4"
  },
  "packageManager": "npm@10.9.4",
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}
