{
  "name": "centaeris",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EchoTrigger/centaeris.git"
  },
  "scripts": {
    "lint": "pnpm run lint:ui && pnpm run lint:web",
    "lint:ui": "node ./node_modules/@biomejs/biome/bin/biome lint packages/ui/src packages/visuals/src",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint:web": "node ./node_modules/@biomejs/biome/bin/biome lint packages/workspace/web/src packages/workspace/web/tests packages/visuals/src packages/ui/src",
    "lint:hooks:web": "node ./node_modules/@biomejs/biome/bin/biome lint packages/workspace/web/src packages/workspace/web/tests --only=lint/correctness/useExhaustiveDependencies",
    "lint:unused:web": "node ./node_modules/@biomejs/biome/bin/biome lint packages/workspace/web/src packages/workspace/web/tests --only=lint/correctness/noUnusedImports --only=lint/correctness/noUnusedVariables"
  },
  "engines": {
    "node": "22.21.0",
    "pnpm": "12.10.1"
  },
  "packageManager": "pnpm@12.10.1",
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}
