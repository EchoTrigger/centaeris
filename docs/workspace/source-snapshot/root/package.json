{
  "name": "centaeris-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "npm run build --workspace packages/web",
    "lint": "node ./node_modules/@biomejs/biome/bin/biome lint packages/web/src packages/web/tests",
    "lint:hooks": "node ./node_modules/@biomejs/biome/bin/biome lint packages/web/src packages/web/tests --only=lint/correctness/useExhaustiveDependencies",
    "lint:unused": "node ./node_modules/@biomejs/biome/bin/biome lint packages/web/src packages/web/tests --only=lint/correctness/noUnusedImports --only=lint/correctness/noUnusedVariables",
    "typecheck": "npm run typecheck --workspace packages/web",
    "test": "npm run test:unit --workspace packages/web"
  },
  "workspaces": [
    "packages/web"
  ],
  "engines": {
    "node": "22.21.0",
    "npm": "10.9.4"
  },
  "packageManager": "npm@10.9.4",
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}
